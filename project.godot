; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Frog Court"
config/name_localized={
"en": "Frog Court"
}
config/version="0.1"
run/main_scene="uid://cl37lpm48ih7m"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[audio]

manager/sound/pool_1D_size=10
manager/sound/pool_3D_size=10

[autoload]

SoundManager="*res://addons/sound_manager/sound_manager.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
Twitch="*res://addons/twitcher/twitch_service.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg", "res://addons/sound_manager/plugin.cfg", "res://addons/twitcher/plugin.cfg", "res://addons/zylann.translation_editor/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "purple",
"res://assets/": "red",
"res://components/": "blue",
"res://data/": "green",
"res://scenes/": "yellow"
}

[filesystem]

import/blender/enabled=false

